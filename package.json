{
  "name": "edge-comments",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:widget": "node scripts/build-widget.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.example.jsonc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:sh": "shellcheck -x deploy.sh $(find scripts -name '*.sh' ! -path scripts/lib/wizard.sh) && shellcheck --exclude=SC1087 scripts/lib/wizard.sh",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:importer": "vitest run --config vitest.importer.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "test:perf": "node scripts/perf-export.mjs",
    "check:size": "npm run build:widget && node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:sh && npm run format:check && npm run test:unit && npm run test:worker && npm run test:importer && npm run check:size",
    "import:disqus": "node scripts/run-cli.mjs disqus-import",
    "create-site": "node scripts/run-cli.mjs create-site"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "hono": "^4.13.19",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.17",
    "markdown-it": "^15.0.3",
    "sanitize-html": "^2.18.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261118.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fast-check": "4.10.3",
    "msw": "2.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  }
}
