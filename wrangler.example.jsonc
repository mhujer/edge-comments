{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-comments",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "comments.example.com", "custom_domain": true }],
  "triggers": { "crons": ["0 3 * * SUN"] },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"],
  },
  "secrets": {
    "required": ["ACCESS_AUD", "TURNSTILE_SITE_KEY", "TURNSTILE_SECRET"],
  },
  "vars": {
    "ADMIN_EMAIL": "admin@example.com",
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    // ./deploy.sh always sets this to edge-comments@<CUSTOM_DOMAIN>.
    "EMAIL_FROM": "",
    "CUSTOM_DOMAIN": "comments.example.com",
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "admin@example.com",
    },
  ],
  "ratelimits": [
    {
      "name": "RL_SUBMIT",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "RL_API",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edge-comments-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "edge-comments-backups",
    },
  ],
}
